# `packages/ipc-types/bindings.ts` is generated by `pnpm gen:types` and
# committed (ADR 0003). The generator always writes LF, on every OS, and CI
# fails the build when the committed file differs from a fresh export. Without
# this line, a Windows checkout with `core.autocrlf=true` would turn the file
# CRLF and make that check fail on a file nobody touched.
packages/ipc-types/bindings.ts text eol=lf
# Golden files are compared byte for byte; a CRLF checkout on Windows must
# not change them. (P0-15 adds the general rule for tests/golden/.)
crates/*/tests/golden/** text eol=lf
# Fixture scripts run under bash on every OS, and bash (Git Bash on Windows
# included) fails on the CR a CRLF checkout adds to each line. (P0-15 adds the
# general rule for fixture inputs.)
scripts/fixtures/** text eol=lf
