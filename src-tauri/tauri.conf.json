{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shootgit",
  "identifier": "dev.placeholder.shootgit",
  "build": {
    "beforeDevCommand": "pnpm --filter ./packages/ui run dev",
    "beforeBuildCommand": "pnpm --filter ./packages/ui run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../packages/ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Shootgit",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
